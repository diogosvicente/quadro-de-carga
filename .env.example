# ============================================================
# Variáveis do docker-compose.prod.yml (no servidor: ~/quadro-de-carga/.env).
# Normalmente NÃO é preciso criar à mão: o scripts/deploy.sh gera o .env no primeiro deploy
# com uma senha aleatória (chmod 600) e nunca o sobrescreve nem o envia ao servidor.
# ============================================================

# Senha do PostgreSQL (usuário/banco "eletrica"). O banco não é exposto fora da rede do compose.
# Gere uma com: openssl rand -hex 24
DB_PASSWORD=troque-esta-senha
